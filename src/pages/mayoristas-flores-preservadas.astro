---
import Layout from "../layouts/Layout.astro";
import Image from "astro/components/Image.astro";
import { products } from "../data/products";

const flowers = products.filter((product) => product.category.includes("flores"));
const priorityCities = ["Ibagué", "Armenia", "Pereira", "Manizales", "Girardot", "Espinal", "Melgar", "Bogotá"];
const wholesalePrice = (slug: string) => (slug === "ramo-gypso-preservado" ? 13000 : 12000);
const whatsappUrl =
  "https://wa.me/573102278592?text=Hola!%20Soy%20de%20una%20floristeria%20y%20quiero%20el%20catalogo%20mayorista%20de%20flores%20preservadas";
---

<Layout
  title="Flores preservadas al por mayor en Colombia | Chiwi"
  description="Proveedor de flores naturales preservadas para floristerías, tiendas y decoradores en Colombia. Solicita catálogo, disponibilidad y precios por volumen."
>
  <main>
    <section class="relative overflow-hidden bg-gradient-to-br from-green-50 via-white to-pink-50 px-4 py-20">
      <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-2">
        <div>
          <span class="inline-block rounded-full bg-green-100 px-4 py-2 text-sm font-semibold text-green-700">
            Para floristerías y tiendas
          </span>
          <h1 class="mt-6 text-4xl font-bold leading-tight text-gray-900 md:text-6xl">
            Flores preservadas al por mayor en Colombia
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-gray-700 md:text-xl">
            Arma tu surtido con flores y follajes naturales preservados para
            reventa, decoración y arreglos que duran por meses.
          </p>
          <div class="mt-5 flex flex-wrap gap-3 text-sm font-semibold text-gray-700">
            <span class="rounded-full bg-white px-4 py-2 shadow-sm">Mínimo: 12 unidades</span>
            <span class="rounded-full bg-white px-4 py-2 shadow-sm">Desde $12.000 COP</span>
            <span class="rounded-full bg-white px-4 py-2 shadow-sm">Despachos desde Ibagué</span>
          </div>
          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-track-content-name="Solicitar catálogo mayorista de flores"
              data-track-content-category="flores_mayoristas"
              class="inline-flex items-center justify-center gap-3 rounded-full bg-[#25D366] px-7 py-4 font-bold text-white shadow-lg transition-all hover:scale-105"
            >
              <ion-icon name="logo-whatsapp" class="text-2xl"></ion-icon>
              Solicitar catálogo mayorista
            </a>
            <a href="#referencias" class="inline-flex items-center justify-center rounded-full border border-green-300 px-7 py-4 font-semibold text-gray-700 transition-colors hover:bg-white">
              Ver referencias
            </a>
          </div>
          <p class="mt-4 text-sm text-gray-600">Pedidos jueves y viernes · Despachos lunes y martes · Pago anticipado.</p>
        </div>
        <div class="overflow-hidden rounded-3xl shadow-2xl">
          <Image
            src={flowers.find((product) => product.slug === "bouquet-surtido-preservado")?.image ?? flowers[0].image}
            alt="Bouquet surtido de flores naturales preservadas para floristerías en Colombia"
            class="h-full max-h-[520px] w-full object-cover"
            width={1000}
            height={800}
            format="webp"
            quality={85}
          />
        </div>
      </div>
    </section>

    <section class="px-4 py-16">
      <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-3">
        <article class="rounded-2xl border border-green-100 bg-white p-6 text-center shadow-sm">
          <div class="text-3xl">🌿</div>
          <h2 class="mt-4 text-xl font-bold text-gray-900">Surtido para reventa</h2>
          <p class="mt-3 text-gray-600">Combina flores, follajes y colores según el estilo de tu negocio.</p>
        </article>
        <article class="rounded-2xl border border-orange-100 bg-white p-6 text-center shadow-sm">
          <div class="text-3xl">📦</div>
          <h2 class="mt-4 text-xl font-bold text-gray-900">Despacho protegido</h2>
          <p class="mt-3 text-gray-600">Coordinamos empaque, disponibilidad y transportadora antes de enviar.</p>
        </article>
        <article class="rounded-2xl border border-pink-100 bg-white p-6 text-center shadow-sm">
          <div class="text-3xl">🤝</div>
          <h2 class="mt-4 text-xl font-bold text-gray-900">Atención comercial</h2>
          <p class="mt-3 text-gray-600">Te ayudamos a elegir referencias para una compra inicial o reposición.</p>
        </article>
      </div>
    </section>

    <section class="bg-green-50 px-4 py-16">
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold text-gray-900">Compra para tu floristería con tranquilidad</h2>
          <ul class="mt-6 space-y-4 text-gray-700">
            <li class="flex gap-3"><span class="text-green-600">✓</span><span><strong>Empieza sin sobrecargarte de inventario:</strong> arma tu primer surtido desde 12 unidades.</span></li>
            <li class="flex gap-3"><span class="text-green-600">✓</span><span><strong>Precios pensados para reventa:</strong> gypso a $13.000 COP y las demás referencias a $12.000 COP.</span></li>
            <li class="flex gap-3"><span class="text-green-600">✓</span><span><strong>Planea tu reposición:</strong> recibimos pedidos jueves y viernes.</span></li>
            <li class="flex gap-3"><span class="text-green-600">✓</span><span><strong>Tu pedido sale rápido:</strong> despachamos lunes y martes por Interrapidísimo.</span></li>
            <li class="flex gap-3"><span class="text-green-600">✓</span><span><strong>Compra segura:</strong> pagas por Bancolombia, Nequi o efectivo en Ibagué antes de que enviemos.</span></li>
          </ul>
        </div>
        <div class="rounded-3xl bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-gray-900">Abastece tu negocio desde Ibagué</h2>
          <p class="mt-4 leading-relaxed text-gray-600">Tomamos pedidos jueves y viernes para preparar tu surtido y despacharlo lunes o martes. Si estás en Ibagué, puedes recibirlo el mismo día del despacho; para Armenia, Pereira, Manizales, Girardot, Espinal, Melgar y Bogotá, calcula entre 1 y 2 días después de que salga.</p>
          <p class="mt-4 text-sm font-semibold text-green-700">Dinos tu ciudad y te confirmamos la fecha más conveniente antes de cobrarte.</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {priorityCities.map((city) => <span class="rounded-full bg-green-100 px-3 py-1 text-sm text-green-800">{city}</span>)}
          </div>
        </div>
      </div>
    </section>

    <section id="referencias" class="bg-gray-50 px-4 py-16">
      <div class="mx-auto max-w-7xl">
        <div class="text-center">
          <h2 class="text-3xl font-bold text-gray-900 md:text-4xl">Referencias disponibles</h2>
          <p class="mx-auto mt-4 max-w-2xl text-gray-600">La disponibilidad de colores y cantidades puede variar. Solicita el inventario actualizado por WhatsApp.</p>
        </div>
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {flowers.map((product) => (
            <article class="overflow-hidden rounded-2xl bg-white shadow-sm">
              <a href={`/productos/${product.slug}`} class="block">
                <Image src={product.image} alt={product.alt} class="h-56 w-full object-cover" width={600} height={450} format="webp" loading="lazy" />
              </a>
              <div class="p-5">
                <h3 class="font-bold text-gray-900">{product.name}</h3>
                <p class="mt-2 text-sm leading-relaxed text-gray-600">{product.description}</p>
                <p class="mt-4 text-sm font-semibold text-orange-600">Mayorista: ${wholesalePrice(product.slug).toLocaleString("es-CO")} COP</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="cotizar" class="bg-gray-50 px-4 py-16">
      <div class="mx-auto max-w-3xl rounded-3xl bg-white p-8 shadow-xl md:p-10">
        <div class="text-center">
          <span class="text-sm font-semibold uppercase tracking-wide text-green-700">Kit inicial disponible</span>
          <h2 class="mt-3 text-3xl font-bold text-gray-900">Solicita tu cotización mayorista</h2>
          <p class="mt-4 text-gray-600">Completa estos datos y te abriremos WhatsApp con la información lista para atender tu pedido.</p>
        </div>
        <form id="wholesale-form" class="mt-8 grid gap-4 sm:grid-cols-2">
          <label class="text-sm font-semibold text-gray-700">Nombre o negocio<input required name="business" class="mt-2 w-full rounded-xl border border-gray-200 px-4 py-3 font-normal focus:border-green-500 focus:outline-none" placeholder="Floristería o nombre" /></label>
          <label class="text-sm font-semibold text-gray-700">Ciudad<input required name="city" class="mt-2 w-full rounded-xl border border-gray-200 px-4 py-3 font-normal focus:border-green-500 focus:outline-none" placeholder="Ej. Bogotá" /></label>
          <label class="text-sm font-semibold text-gray-700">Cantidad aproximada<input required name="quantity" type="number" min="12" class="mt-2 w-full rounded-xl border border-gray-200 px-4 py-3 font-normal focus:border-green-500 focus:outline-none" placeholder="Mínimo 12" /></label>
          <label class="text-sm font-semibold text-gray-700">Referencias o colores<input name="references" class="mt-2 w-full rounded-xl border border-gray-200 px-4 py-3 font-normal focus:border-green-500 focus:outline-none" placeholder="Gypso, statis, surtido..." /></label>
          <button type="submit" class="sm:col-span-2 inline-flex items-center justify-center gap-3 rounded-full bg-[#25D366] px-7 py-4 font-bold text-white shadow-lg transition-all hover:scale-105">
            <ion-icon name="logo-whatsapp" class="text-2xl"></ion-icon>
            Solicitar catálogo y disponibilidad
          </button>
        </form>
        <p class="mt-5 text-center text-sm text-gray-500">También puedes escribir a <a class="font-semibold text-green-700 hover:underline" href="mailto:contacto@chiwicolombia.com">contacto@chiwicolombia.com</a>.</p>
      </div>
    </section>

    <section class="px-4 py-16">
      <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold text-gray-900">Cómo comprar al por mayor</h2>
          <ol class="mt-8 space-y-5">
            <li class="flex gap-4"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-green-100 font-bold text-green-700">1</span><span class="text-gray-700">Cuéntanos tu ciudad, negocio, cantidad y referencias de interés.</span></li>
            <li class="flex gap-4"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-green-100 font-bold text-green-700">2</span><span class="text-gray-700">Confirmamos stock, colores, mínimo de compra, precio y despacho.</span></li>
            <li class="flex gap-4"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-green-100 font-bold text-green-700">3</span><span class="text-gray-700">Aprobamos el pedido y coordinamos el pago y el envío.</span></li>
          </ol>
        </div>
        <div class="rounded-3xl bg-gradient-to-br from-green-600 to-teal-700 p-8 text-white shadow-xl">
          <h2 class="text-3xl font-bold">¿Quieres empezar con un surtido?</h2>
          <p class="mt-4 leading-relaxed text-white/90">Escríbenos y te compartimos el catálogo mayorista actualizado con las referencias disponibles para tu ciudad.</p>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-track-content-name="WhatsApp floristerías mayoristas"
            data-track-content-category="flores_mayoristas"
            class="mt-8 inline-flex items-center gap-3 rounded-full bg-white px-7 py-4 font-bold text-green-700 shadow-lg transition-all hover:scale-105"
          >
            <ion-icon name="logo-whatsapp" class="text-2xl"></ion-icon>
            Hablar con un asesor
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const wholesaleForm = document.getElementById("wholesale-form");
  wholesaleForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!(wholesaleForm instanceof HTMLFormElement)) return;

    const formData = new FormData(wholesaleForm);
    const message = [
      "Hola Chiwi. Quiero solicitar el catálogo mayorista de flores preservadas.",
      `Negocio: ${formData.get("business")}`,
      `Ciudad: ${formData.get("city")}`,
      `Cantidad: ${formData.get("quantity")} unidades`,
      `Referencias o colores: ${formData.get("references") || "Por recomendar"}`,
    ].join("\n");

    window.open(`https://wa.me/573102278592?text=${encodeURIComponent(message)}`, "_blank", "noopener,noreferrer");
  });
</script>
