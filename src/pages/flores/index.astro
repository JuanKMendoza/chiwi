---
import Layout from "../../layouts/Layout.astro";
import Image from "astro/components/Image.astro";
import { products } from "../../data/products";

const flowers = products.filter((product) => product.category.includes("flores"));
const heroProduct = flowers.find((product) => product.slug === "bouquet-surtido-preservado") ?? flowers[0];
const whatsapp = "https://wa.me/573102278592";
const quoteUrl = `${whatsapp}?text=${encodeURIComponent("Hola Chiwi. Quiero cotizar flores preservadas.\nCiudad: \nUso (floristería, decoración, evento o regalo): \nReferencias: \nCantidad aproximada: ")}`;
const catalogPdf = "/Catalogo-Flores-Naturales-Preservadas-Chiwi.pdf";
const colors: Record<string, string> = {
  "ramo-gypso-preservado": "Blanco y tonos suaves", "ramo-statis-preservado": "Lila, amarillo y verde", "ramo-aster-preservado": "Tonos cálidos según stock", "ramo-caspia-preservada": "Colores variados según stock", "ramo-ruscus-preservado": "Verde y rosado", "ramo-eucalipto-preservado": "Verdes naturales", "mini-rosas-preservadas": "Rosa, verde y multicolor", "bouquet-surtido-preservado": "Paleta personalizable según stock",
};
const audience = [["storefront-outline", "Floristerías", "Amplía tu surtido con flores y follajes que conservan su apariencia."], ["color-palette-outline", "Decoradores", "Crea ambientes y arreglos naturales sin mantenimiento diario."], ["sparkles-outline", "Eventos", "Detalles duraderos para mesas, recuerdos y ambientaciones."], ["rocket-outline", "Emprendedores", "Una categoría versátil para vender, combinar y personalizar."], ["gift-outline", "Regalos", "Un detalle natural que acompaña un momento especial."]];
const benefits = [["leaf-outline", "Apariencia natural", "Flores reales tratadas para conservar textura y color."], ["time-outline", "Duración de meses", "No necesitan agua y se disfrutan mucho más tiempo."], ["color-palette-outline", "Colores exclusivos", "Elige tonos disponibles o arma una mezcla a tu gusto."], ["pricetags-outline", "Venta mayorista", "Descuento por volumen desde 12 unidades."], ["car-outline", "Envíos nacionales", "Confirmamos disponibilidad y despacho para tu ciudad."]];
const faqs = [["¿Las flores preservadas son naturales?", "Sí. Son flores reales que pasan por un proceso de preservación para conservar su apariencia, color y textura durante meses."], ["¿Cuánto duran las flores preservadas?", "Con cuidados simples, las flores naturales preservadas pueden conservar su apariencia por meses. No necesitan agua; recomendamos mantenerlas lejos de humedad y sol directo."], ["¿Cómo se envían las flores preservadas?", "Preparamos el pedido con empaque protegido y confirmamos contigo la transportadora, disponibilidad y fecha estimada antes de enviarlo a tu ciudad."], ["¿Venden flores preservadas al detal?", "Sí. Puedes comprar al detal para regalos, decoración o proyectos personales, y también solicitar una cotización para compras por volumen."], ["¿Hay descuentos por volumen?", "Sí. Aplicamos descuento para compras desde 12 unidades. Escríbenos con las referencias y cantidades para recibir una cotización actualizada."], ["¿Desde cuántas unidades aplica el precio mayorista?", "El precio mayorista aplica desde 12 unidades, combinando referencias según la disponibilidad."], ["¿Realizan envíos nacionales?", "Sí, realizamos envíos nacionales en Colombia. Indícanos tu ciudad para confirmar cobertura, tiempos y costo de envío."]];
const pageUrl = "https://chiwicolombia.com/flores/";
const schema = { "@context": "https://schema.org", "@graph": [
  { "@type": "Organization", "@id": "https://chiwicolombia.com/#organization", name: "Chiwi Colombia", url: "https://chiwicolombia.com", telephone: "+57-310-227-8592" },
  { "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Inicio", item: "https://chiwicolombia.com/" }, { "@type": "ListItem", position: 2, name: "Flores preservadas", item: pageUrl }] },
  ...flowers.map((product) => ({ "@type": "Product", name: product.name, image: new URL(product.image.src, "https://chiwicolombia.com").href, description: `Flores naturales preservadas: ${product.name.toLowerCase()}. Colores disponibles según stock.`, brand: { "@type": "Brand", name: "Chiwi Colombia" }, offers: { "@type": "Offer", priceCurrency: "COP", price: product.price, availability: "https://schema.org/InStock", url: `${pageUrl}#productos` } })),
  { "@type": "FAQPage", mainEntity: faqs.map(([name, text]) => ({ "@type": "Question", name, acceptedAnswer: { "@type": "Answer", text } })) },
]};
---

<Layout title="Flores preservadas en Colombia | Al detal y al por mayor | Chiwi" description="Compra flores naturales preservadas al detal y al por mayor en Colombia: eucalipto, gypsophila, caspia, statis y ruscus preservado. Cotiza envíos nacionales desde 12 unidades." image={heroProduct.image.src} ogImageAlt="Bouquet de flores naturales preservadas de Chiwi Colombia">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(schema)} /></Fragment>
  <main>
    <section class="relative overflow-hidden bg-gradient-to-br from-green-50 via-white to-pink-50 px-4 py-16 md:py-20" aria-labelledby="flores-heading"><div class="mx-auto flex max-w-7xl flex-col items-stretch gap-0 lg:grid lg:grid-cols-2 lg:items-center lg:gap-12"><div class="contents lg:block"><span class="order-1 inline-flex self-start rounded-full bg-green-100 px-4 py-2 text-sm font-semibold text-green-800">Flores naturales preservadas</span><h1 id="flores-heading" class="order-3 mt-6 text-[2rem] font-bold leading-[1.1] text-gray-900 sm:text-4xl md:text-6xl">Flores naturales preservadas al por mayor y al detal en Colombia</h1><p class="order-4 mt-5 max-w-2xl text-lg leading-relaxed text-gray-700 md:text-xl">Flores eternas: eucalipto, gypsophila preservada, caspia, statis y ruscus para floristerías, decoración, eventos y regalos.</p><ul class="order-5 mt-6 grid gap-3 text-sm font-semibold text-gray-800 sm:grid-cols-3" aria-label="Ventajas de compra"><li class="rounded-full bg-white px-4 py-3 shadow-sm"><span class="mr-2 text-green-700">✓</span>Envíos nacionales</li><li class="rounded-full bg-white px-4 py-3 shadow-sm"><span class="mr-2 text-green-700">✓</span>Al detal y mayorista</li><li class="rounded-full bg-white px-4 py-3 shadow-sm"><span class="mr-2 text-green-700">✓</span>Descuento desde 12</li></ul><div class="order-6 mt-8 flex flex-col gap-3 sm:flex-row"><a href={quoteUrl} target="_blank" rel="noopener noreferrer" data-track-content-name="Solicitar cotización flores preservadas" data-track-content-category="flores" class="inline-flex items-center justify-center gap-3 rounded-full bg-[#25D366] px-7 py-4 font-bold text-white shadow-lg transition hover:-translate-y-0.5 hover:shadow-xl"><ion-icon name="logo-whatsapp" class="text-2xl" aria-hidden="true"></ion-icon>Solicitar cotización</a><a href={catalogPdf} download data-track-event="catalog_download" data-track-content-name="Catálogo PDF de flores preservadas" data-track-content-category="flores" data-track-source-section="hero_flores" class="inline-flex items-center justify-center gap-2 rounded-full border border-green-700 bg-white px-7 py-4 font-bold text-green-800 transition hover:bg-green-50"><ion-icon name="download-outline" class="text-xl" aria-hidden="true"></ion-icon>Ver catálogo PDF</a></div></div><div class="order-2 mt-5 overflow-hidden rounded-3xl shadow-2xl lg:order-none lg:mt-0"><Image src={heroProduct.image} alt="Bouquet surtido de flores naturales preservadas para comprar en Colombia" class="h-full max-h-[520px] w-full object-cover" width={1000} height={800} format="webp" quality={85} loading="eager" /></div></div></section>

    <section class="px-4 py-16" aria-labelledby="audiencia-heading"><div class="mx-auto max-w-7xl"><div class="text-center"><h2 id="audiencia-heading" class="text-3xl font-bold text-gray-900 md:text-4xl">¿Para quién son estas flores?</h2><p class="mx-auto mt-3 max-w-2xl text-gray-600">Una opción natural y versátil, ya sea que compres una referencia o armes un surtido.</p></div><div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">{audience.map(([icon, title, text]) => <article class="rounded-2xl border border-green-100 bg-white p-5 text-center shadow-sm"><ion-icon name={icon} class="text-3xl text-green-700" aria-hidden="true"></ion-icon><h3 class="mt-3 text-lg font-bold text-gray-900">{title}</h3><p class="mt-2 text-sm leading-relaxed text-gray-600">{text}</p></article>)}</div></div></section>
    <section class="bg-green-50 px-4 py-16" aria-labelledby="beneficios-heading"><div class="mx-auto max-w-7xl"><div class="text-center"><h2 id="beneficios-heading" class="text-3xl font-bold text-gray-900 md:text-4xl">Belleza natural que dura más</h2></div><div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">{benefits.map(([icon, title, text]) => <article class="rounded-2xl bg-white p-5 text-center shadow-sm"><ion-icon name={icon} class="text-3xl text-[#E8909A]" aria-hidden="true"></ion-icon><h3 class="mt-3 font-bold text-gray-900">{title}</h3><p class="mt-2 text-sm text-gray-600">{text}</p></article>)}</div></div></section>
    <section id="productos" class="bg-gray-50 px-4 py-16" aria-labelledby="productos-heading"><div class="mx-auto max-w-7xl"><div class="flex flex-col items-center justify-between gap-4 text-center md:flex-row md:text-left"><div><h2 id="productos-heading" class="text-3xl font-bold text-gray-900 md:text-4xl">Flores y follajes disponibles</h2><p class="mt-3 max-w-2xl text-gray-600">Consulta colores y disponibilidad antes de confirmar tu pedido.</p></div><a href={catalogPdf} download data-track-event="catalog_download" data-track-content-name="Catálogo PDF de flores preservadas" data-track-content-category="flores" data-track-source-section="productos_flores" class="inline-flex items-center gap-2 rounded-full bg-[#1E6B50] px-6 py-3 font-bold text-white shadow-sm transition hover:bg-[#15523d]"><ion-icon name="download-outline" aria-hidden="true"></ion-icon>Descargar catálogo completo</a></div><div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">{flowers.map((product) => <article class="overflow-hidden rounded-2xl bg-white shadow-sm"><Image src={product.image} alt={product.alt} class="h-56 w-full object-cover" width={600} height={450} format="webp" loading="lazy" /><div class="p-5"><h3 class="text-lg font-bold text-gray-900">{product.name}</h3><dl class="mt-3 space-y-2 text-sm text-gray-600"><div class="flex gap-2"><dt class="font-semibold text-gray-800">Colores:</dt><dd>{colors[product.slug] ?? "Según disponibilidad"}</dd></div><div class="flex gap-2"><dt class="font-semibold text-gray-800">Duración:</dt><dd>Meses con cuidados simples</dd></div></dl><a href={`${whatsapp}?text=${encodeURIComponent(`Hola Chiwi. Quiero cotizar ${product.name}.`)}`} target="_blank" rel="noopener noreferrer" data-track-content-name={`Cotizar ${product.name}`} data-track-content-category="flores" class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#25D366] px-4 py-3 font-bold text-white transition hover:bg-[#1fb85a]"><ion-icon name="logo-whatsapp" aria-hidden="true"></ion-icon>Cotizar</a></div></article>)}</div></div></section>
    <section class="px-4 py-16" aria-labelledby="proceso-heading"><div class="mx-auto max-w-6xl"><div class="text-center"><h2 id="proceso-heading" class="text-3xl font-bold text-gray-900 md:text-4xl">Comprar es muy sencillo</h2></div><ol class="mt-10 grid gap-6 md:grid-cols-4"><li class="text-center"><ion-icon name="logo-whatsapp" class="text-3xl text-green-700" aria-hidden="true"></ion-icon><h3 class="mt-3 font-bold text-gray-900">1. Escríbenos</h3><p class="mt-2 text-sm text-gray-600">Cuéntanos qué referencias, cantidades y ciudad necesitas.</p></li><li class="text-center"><ion-icon name="document-text-outline" class="text-3xl text-green-700" aria-hidden="true"></ion-icon><h3 class="mt-3 font-bold text-gray-900">2. Recibe la cotización</h3><p class="mt-2 text-sm text-gray-600">Te compartimos opciones, precios y condiciones.</p></li><li class="text-center"><ion-icon name="checkmark-circle-outline" class="text-3xl text-green-700" aria-hidden="true"></ion-icon><h3 class="mt-3 font-bold text-gray-900">3. Confirmamos disponibilidad</h3><p class="mt-2 text-sm text-gray-600">Validamos colores y existencias antes del pago.</p></li><li class="text-center"><ion-icon name="car-outline" class="text-3xl text-green-700" aria-hidden="true"></ion-icon><h3 class="mt-3 font-bold text-gray-900">4. Enviamos a tu ciudad</h3><p class="mt-2 text-sm text-gray-600">Preparamos tu pedido con empaque protegido.</p></li></ol></div></section>
    <section class="bg-green-50 px-4 py-16" aria-labelledby="faq-heading"><div class="mx-auto max-w-4xl"><div class="text-center"><h2 id="faq-heading" class="text-3xl font-bold text-gray-900 md:text-4xl">Preguntas frecuentes sobre flores preservadas</h2></div><div class="mt-8 space-y-3">{faqs.map(([question, answer]) => <details class="rounded-2xl bg-white px-6 py-4 shadow-sm"><summary class="cursor-pointer pr-8 font-bold text-gray-900">{question}</summary><p class="mt-3 leading-relaxed text-gray-600">{answer}</p></details>)}</div></div></section>
    <section id="cotizar" class="px-4 py-16"><div class="mx-auto max-w-5xl rounded-3xl bg-gradient-to-br from-[#1E6B50] to-[#78C4A8] px-7 py-12 text-center text-white shadow-xl md:px-12"><h2 class="text-3xl font-bold md:text-4xl">¿Listo para comenzar?</h2><p class="mx-auto mt-4 max-w-2xl text-lg text-white/90">Solicita disponibilidad y una cotización para tu compra al detal o al por mayor.</p><a href={quoteUrl} target="_blank" rel="noopener noreferrer" data-track-content-name="WhatsApp CTA final flores preservadas" data-track-content-category="flores" class="mt-8 inline-flex items-center gap-3 rounded-full bg-white px-7 py-4 font-bold text-green-800 shadow-lg transition hover:-translate-y-0.5"><ion-icon name="logo-whatsapp" class="text-2xl" aria-hidden="true"></ion-icon>Hablar por WhatsApp</a></div></section>
  </main>
</Layout>
